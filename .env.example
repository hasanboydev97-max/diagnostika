# AI va MongoDB kalitlari
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# MONGODB DATA API (SaaS uchun markaziy baza)
# Ushbu kalitlarni MongoDB Atlas dan olasiz (App Services -> Data API)
VITE_MONGO_API_URL=https://data.mongodb-api.com/app/data-xxxxx/endpoint/data/v1
VITE_MONGO_API_KEY=your_mongo_data_api_key
VITE_MONGO_CLUSTER=Cluster0

# CLOUDINARY (Rasmlarni bulutga saqlash uchun)
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
VITE_CLOUDINARY_PRESET=your_upload_preset
